# Development container for barry (same base and tooling as epiworld's).
FROM mcr.microsoft.com/devcontainers/cpp:1-ubuntu-24.04

ARG PYTHON_VERSION=3.12
# Non-root user provided by the base image (the dev container's remote user)
ARG USERNAME=vscode

ENV DEBIAN_FRONTEND=noninteractive

# Install uv
COPY --from=ghcr.io/astral-sh/uv:0.9.5 /uv /uvx /bin/

# Compilers, debugging/profiling tools, and documentation tools
RUN apt-get update && \
    apt-get install -y \
        build-essential \
        make \
        git \
        sudo \
        pkg-config \
        doxygen \
        graphviz \
        gdb \
        valgrind && \
    rm -rf /var/lib/apt/lists/*

USER $USERNAME

# MkDocs with the same versions used by `make docs` and the docs workflow
RUN uv python install ${PYTHON_VERSION} && \
    uv tool install --python ${PYTHON_VERSION} "mkdocs<2" \
        --with "mkdocs-material>=9.7.5,<10" \
        --with mkdoxy

ENV PATH="/home/${USERNAME}/.local/bin:${PATH}"

WORKDIR /workspaces/barry
